# Copy to .env and change the values. Never commit .env.
POSTGRES_DB=recovery_companion
POSTGRES_USER=recovery
POSTGRES_PASSWORD=
SERVER_ENABLE_DOCS=false
# Support-circle push through Expo. Leave false until FCM is set up for the Expo
# project (google-services.json + FCM key in EAS). Supporters still see requests in the app.
SERVER_PUSH_ENABLED=false
# Web demo only: let the browser app (Expo web) call the API. Empty = no browser access.
SERVER_CORS_ORIGINS=http://localhost:8081
# Only behind an HTTPS proxy (docs/deploy.md): the proxy's address or network, so
# per-address limits see each client. Empty = trust no forwarded headers.
SERVER_TRUSTED_PROXIES=
# AI coach (milestone 9). Ollama model the coach uses; pull it first: `ollama pull qwen2.5:7b`.
COACH_MODEL=qwen2.5:7b
# Where the coach finds Ollama. Default: the Mac's own Ollama app.
COACH_OLLAMA_URL=http://host.docker.internal:11434
# Web demo only: let the browser app call the coach. Empty = no browser access.
COACH_CORS_ORIGINS=http://localhost:8081
# Who can reach the coach. 127.0.0.1 = this computer only (default; use `adb reverse` for a
# phone). 0.0.0.0 = anyone on the Wi-Fi, unencrypted: test setups only.
COACH_BIND=127.0.0.1
