# Copy to .env and change the values. Never commit .env.
POSTGRES_DB=recovery_companion
POSTGRES_USER=recovery
POSTGRES_PASSWORD=
SERVER_ENABLE_DOCS=false
# Support-circle push through Expo. Leave false until FCM is set up for the Expo
# project (google-services.json + FCM key in EAS). Supporters still see requests in the app.
SERVER_PUSH_ENABLED=false
# Web demo only: let the browser app (Expo web) call the API. Empty = no browser access.
SERVER_CORS_ORIGINS=http://localhost:8081
