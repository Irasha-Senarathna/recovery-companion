{
  "name": "recovery-companion",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@noble/hashes": "^2.4.0",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.27",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.5.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-plugin-i18next": "^6.1.5",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write ."
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "md"
    ],
    "transform": {
      "\\.md$": "<rootDir>/jest.md-transformer.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble))",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
